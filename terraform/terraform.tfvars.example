# ============================================
# Terraform Variables Example
# ============================================
# Copy this file to terraform.tfvars and fill in the values.
# DO NOT commit terraform.tfvars to version control!
# ============================================

# AWS Region (us-east-1 has best free tier availability)
aws_region = "us-east-1"

# Environment name
environment = "dev"

# EC2 instance type (t3.micro for free tier)
instance_type = "t3.micro"

# Name of your SSH key pair in AWS Console
# This should match the key you see in EC2 > Key Pairs
ssh_key_name = "kv's macbook"

# PostgreSQL password - generate with: openssl rand -base64 24
postgres_password = "REPLACE_WITH_GENERATED_PASSWORD"

# Your IP address for SSH/K8s access
# Find your IP: curl -s ifconfig.me
# IMPORTANT: Add /32 suffix for single IP
allowed_cidrs = ["YOUR_IP_HERE/32"]

# Example with specific IP:
# allowed_cidrs = ["203.0.113.42/32"]
